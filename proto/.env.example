# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Prototype server port (main Samvaad app uses 3000)
PROTO_PORT=3001

# TTS voice — use a NATIVE Gujarati voice from the Extended Voice Library:
#   gu-in-concierge-1   (male, Gujarati accent)
#   gu-in-techagent-1   (female, Gujarati accent)
# English voices like Kore speak Gujarati with a forced English accent.
PROTO_TTS_VOICE=gu-in-techagent-1

# --- TTS provider switch (A/B testing) ---
# gemini = gemini-3.8-flash-tts with voice above
# sarvam = Bulbul v4 Flash (native Gujarati, ₹1/1k chars, no daily cap)
TTS_PROVIDER=gemini

# Required only when TTS_PROVIDER=sarvam.
# Leave blank to reuse SAMVAAD_API_KEY from the project-root .env.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_VOICE=shubh_enhi_ads
