# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Prototype server port (main Samvaad app uses 3000)
PROTO_PORT=3001

# TTS voice — use a NATIVE Gujarati voice from the Extended Voice Library:
#   gu-in-concierge-1   (male, Gujarati accent)
#   gu-in-techagent-1   (female, Gujarati accent)
# English voices like Kore speak Gujarati with a forced English accent.
PROTO_TTS_VOICE=gu-in-techagent-1

# --- Response generation / context ---
# Answer model: gemini-3.5-flash-lite (cheap) or gemini-3.5-flash (better)
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# Prior turns sent back to the LLM (0 disables conversation context)
CONTEXT_TURNS=3
# Cache identical turns (answer + audio) in memory
CACHE_ANSWERS=true

# --- Bulbul tuning (all optional) ---
SARVAM_TTS_STREAMING=true
SARVAM_PREPROCESSING=false
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
# SARVAM_TTS_DICT_ID=p_xxxxxxxx

# --- TTS provider switch (A/B testing) ---
# gemini = Gemini TTS with voice above; sarvam = Bulbul v4 Flash
TTS_PROVIDER=gemini

# Gemini TTS model (only used when TTS_PROVIDER=gemini):
#   gemini-3.8-flash-tts       ($9/M audio out, higher fidelity)
#   gemini-3.8-flash-lite-tts  ($6/M audio out, cheaper, hit 10/day free cap)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Required only when TTS_PROVIDER=sarvam.
# Leave blank to reuse SAMVAAD_API_KEY from the project-root .env.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_VOICE=shubh_enhi_ads
