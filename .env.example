# --- Required: Sarvam Voice Agents (Samvaad) API key ---
# Create at: Sarvam Dashboard -> Voice Agents -> Settings -> API Keys
# (https://indus.sarvam.ai) — NEVER exposed to the browser; the proxy adds it.
SAMVAAD_API_KEY=your_samvaad_api_key_here

# --- Agent identifiers (from your Samvaad workspace) ---
# These are NOT secrets — they are sent to the browser via GET /api/config,
# but keeping them here means one config place. Leave blank until you create
# the agent; the UI will show a setup hint.
SAMVAAD_ORG_ID=
SAMVAAD_WORKSPACE_ID=
SAMVAAD_APP_ID=

# --- Optional ---
# Server port (default: 3000)
PORT=3000

# Sarvam app-runtime base URL (rarely changes)
SAMVAAD_RUNTIME_BASE_URL=https://apps.sarvam.ai/api/app-runtime/
