# --- Required API keys ---

# Sarvam AI API key (STT + TTS): https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Google AI Studio / Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional overrides ---

# Server port (default: 3000)
PORT=3000

# Gemini model to use (default: gemini-3.5-flash)
# Alternatives: gemini-3.5-flash-lite (cheapest/fastest), gemini-3.8-flash (newest)
GEMINI_MODEL=gemini-3.5-flash

# BCP-47 language code for STT input and TTS output (default: gu-IN)
LANGUAGE_CODE=gu-IN

# Sarvam STT model (default: saaras:v4)
SARVAM_STT_MODEL=saaras:v4

# Sarvam TTS model (default: bulbul:v3)
SARVAM_TTS_MODEL=bulbul:v3

# Sarvam TTS speaker/voice (default: shubh). For bulbul:v3 use short names like
# shubh, aditya, ritu, priya... For bulbul:v4-flash use persona IDs like
# bhavik_gu_conversation, pooja_gu_conversational
SARVAM_TTS_SPEAKER=shubh

# Assistant persona name used in the system prompt (default: Sahayak)
ASSISTANT_NAME=Sahayak
